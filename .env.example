# ─── Copia este archivo a .env y ajusta los valores ──────────────────────────
# cp .env.example .env

# Base de datos (solo accesible desde el propio equipo, pero cambia la contraseña)
POSTGRES_USER=lansentinel
POSTGRES_PASSWORD=lansentinel_pass
POSTGRES_DB=lansentinel

# Backend
# Clave de firma de las sesiones. Déjala vacía para que se genere sola y se
# guarde en /var/lib/lansentinel/secret_key, o pon una con: openssl rand -hex 32
SECRET_KEY=
ENVIRONMENT=production   # development | production

# Primer administrador del panel (solo se usa si aún no hay usuarios).
# Sin ADMIN_PASSWORD se genera una aleatoria; léela con:
#   sudo cat /var/lib/lansentinel/initial_admin_password
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Panel por HTTPS con un certificado de la CA propia de LanSentinel (se
# genera solo en /var/lib/lansentinel/tls). Por HTTP solo se redirige.
# PANEL_HTTPS_PORT=443
# PANEL_HTTP_PORT=80        # el 3000 también redirige siempre: no uses ese
# La cookie de sesión se marca Secure sola al entrar por HTTPS; true la fuerza
# siempre (útil detrás de otro proxy con TLS)
# SESSION_COOKIE_SECURE=false

# Red a monitorizar (interfaz del host o gateway)
MONITOR_INTERFACE=eth0

# Modo router (lo configura scripts/instalar.sh): LanSentinel enruta entre la
# WAN y la LAN (MONITOR_INTERFACE) con NAT, cierra la WAN a conexiones
# entrantes y sirve DHCP y DNS. ROUTER_MODE es el estado inicial; después se
# enciende y apaga desde Ajustes del panel.
# ROUTER_MODE=false
# WAN_INTERFACE=eth1
# ROUTER_DHCP=true                # false si DHCP y DNS los da otro equipo
# DHCP_RANGE_START=192.168.50.100
# DHCP_RANGE_END=192.168.50.199
# DHCP_LEASE_TIME=12h
# DNS_UPSTREAM=1.1.1.1,9.9.9.9
# LOCAL_DOMAIN=lan

# Fabricantes: se usa la lista pública del IEEE descargada al equipo. Pon true
# para consultar también macvendors.com (envía las MACs de la red a un tercero)
# OUI_ONLINE_LOOKUP=false

# Detección
# Escucha pasiva de ARP para detectar suplantaciones (ARP spoofing)
# ARP_SPOOF_DETECTION=true
# Escaneo periódico de puertos de todos los dispositivos (0 = desactivado)
# PORT_SCAN_INTERVAL_HOURS=24

# Cortafuegos
# IPs o rangos que nunca se bloquean, además de las del propio equipo y su
# puerta de enlace (se detectan solas). Formato JSON.
# FIREWALL_NEVER_BLOCK=["192.168.1.2", "192.168.1.0/28"]

# Listas de IPs maliciosas que el cortafuegos corta (FireHOL nivel 1 y
# abuse.ch por defecto; formato nombre=url separados por comas)
# THREAT_LISTS_ENABLED=true
# THREAT_LISTS=firehol_level1=https://iplists.firehol.org/files/firehol_level1.netset,feodo=https://feodotracker.abuse.ch/downloads/ipblocklist.txt
# THREAT_LISTS_UPDATE_HOURS=24

# Picos de consumo por dispositivo (alerta si una hora se dispara respecto a
# lo habitual de las últimas semanas)
# ANOMALY_DETECTION_ENABLED=true
# ANOMALY_BASELINE_DAYS=14
# ANOMALY_MIN_HISTORY_HOURS=48     # horas con actividad antes de juzgar un dispositivo
# ANOMALY_FACTOR=5                 # veces lo habitual
# ANOMALY_UPLOAD_MIN_MB=100
# ANOMALY_DOWNLOAD_MIN_MB=2048

# Dominios (DNS y SNI) y huellas TLS por dispositivo: es el historial de
# navegación de cada equipo; se borra a los N días sin verse
# DOMAIN_TRACKING_ENABLED=true
# DOMAIN_HISTORY_DAYS=30

# Registro de acciones (Ajustes → Registro de acciones): días que se guarda
# AUDIT_LOG_DAYS=365

# Reglas de Emerging Threats para Suricata: cada cuántas horas se actualizan
# (0 lo desactiva; la primera descarga se hace siempre al arrancar)
# RULES_UPDATE_HOURS=24
# Tamaño a partir del cual se rotan eve.json, fast.log y stats.log (se
# guarda el actual y uno anterior)
# SURICATA_LOG_MAX_MB=100

# IPv6 en la LAN (solo en modo router; scripts/instalar.sh --ipv6). El prefijo
# sale de IPV6_PREFIX, del que delegue la operadora (DHCPv6-PD) o, si no
# delega ninguno, de una ULA propia con NAT66
# IPV6_LAN=false
# IPV6_PREFIX=                     # p. ej. 2a02:xxxx:xxxx:xx00::/56 si es fijo
# IPV6_PD=true
# IPV6_NAT_FALLBACK=true

# Avisos de alertas nuevas fuera del panel (Telegram, ntfy, correo).
# Un canal se activa al rellenar sus variables. Pruébalos en Ajustes del panel.
# NOTIFY_MIN_SEVERITY=high        # info | low | medium | high | critical
# NOTIFY_MAX_PER_HOUR=20
# PANEL_URL=https://192.168.1.10   # para incluir un enlace en los avisos
#
# Telegram: token de @BotFather y tu chat_id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# ntfy: app ntfy en el móvil suscrita al mismo tema (usa un nombre difícil de adivinar)
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
#
# Correo (Gmail/Outlook: contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls          # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=                        # varias direcciones separadas por comas

# Copias de seguridad (base de datos, /var/lib/lansentinel y este .env)
# Hora local de la copia diaria; -1 desactiva las automáticas
# BACKUP_HOUR=3
# Se conservan las 7 más recientes y una por semana de las 4 semanas anteriores
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Carpeta del equipo donde se guardan (mejor en otro disco: si se estropea el
# del sistema, se pierden las copias con él). Por defecto:
# BACKUP_PATH=/var/lib/lansentinel/backups
