# ─── Copia este archivo a .env y ajusta los valores ──────────────────────────
# cp .env.example .env

# Base de datos (solo accesible desde el propio equipo, pero cambia la contraseña)
POSTGRES_USER=lansentinel
POSTGRES_PASSWORD=lansentinel_pass
POSTGRES_DB=lansentinel

# Backend
# Clave de firma de las sesiones. Déjala vacía para que se genere sola y se
# guarde en /var/lib/lansentinel/secret_key, o pon una con: openssl rand -hex 32
SECRET_KEY=
ENVIRONMENT=production   # development | production

# Primer administrador del panel (solo se usa si aún no hay usuarios).
# Sin ADMIN_PASSWORD se genera una aleatoria; léela con:
#   sudo cat /var/lib/lansentinel/initial_admin_password
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Pon true si sirves el panel por HTTPS (la cookie de sesión solo viajará cifrada)
# SESSION_COOKIE_SECURE=false

# Red a monitorizar (interfaz del host o gateway)
MONITOR_INTERFACE=eth0

# Fabricantes: se usa la lista pública del IEEE descargada al equipo. Pon true
# para consultar también macvendors.com (envía las MACs de la red a un tercero)
# OUI_ONLINE_LOOKUP=false

# Cortafuegos
# IPs o rangos que nunca se bloquean, además de las del propio equipo y su
# puerta de enlace (se detectan solas). Formato JSON.
# FIREWALL_NEVER_BLOCK=["192.168.1.2", "192.168.1.0/28"]

# Frontend
# Dirección del backend para nginx (producción) y el proxy de Vite (desarrollo).
# Por defecto http://host.docker.internal:8000; descomenta si el contenedor no
# alcanza el host por esa vía y pon la IP del equipo.
# BACKEND_URL=http://192.168.56.10:8000
